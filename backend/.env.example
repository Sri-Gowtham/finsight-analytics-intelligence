# ── Server ───────────────────────────────────────────
PORT=3001

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finsight

# ── Authentication ───────────────────────────────────
JWT_SECRET=change-me-to-a-random-secret

# ── OpenAI ───────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── CORS ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:8081

# ── SMTP (Nodemailer for OTP emails) ─────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password123

# ── Google OAuth 2.0 ─────────────────────────────────
# To get credentials: go to console.cloud.google.com -> APIs & Services -> Credentials -> Create OAuth 2.0 Client ID.
# Set Authorized redirect URI = http://localhost:8081/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=finsight-oauth-secret-key
GOOGLE_CALLBACK_URL=http://localhost:8081/api/auth/google/callback
