# ── Server ───────────────────────────────────────────
PORT=3001

# ── Database ─────────────────────────────────────────
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/finsight

# ── Authentication ───────────────────────────────────
JWT_SECRET=change-me-to-a-random-secret

# ── OpenAI ───────────────────────────────────────────
OPENAI_API_KEY=sk-...

# ── CORS ─────────────────────────────────────────────
FRONTEND_URL=http://localhost:8081

# ── SMTP (Nodemailer for OTP emails) ─────────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=user@example.com
SMTP_PASS=password123

# ═══════════════════════════════════════════════════════════
# GOOGLE OAUTH SETUP — required for "Continue with Google"
# ═══════════════════════════════════════════════════════════
# 1. Go to https://console.cloud.google.com
# 2. Create a project (or select existing)
# 3. Go to APIs & Services → OAuth consent screen
#    - User Type: External
#    - Fill in App name: FinSight, User support email, Developer email
#    - Save and continue through all steps
# 4. Go to APIs & Services → Credentials
#    - Click "Create Credentials" → "OAuth 2.0 Client ID"
#    - Application type: Web application
#    - Name: FinSight Local Dev
#    - Authorized JavaScript origins: http://localhost:8081
#    - Authorized redirect URIs: http://localhost:3001/api/auth/google/callback
#      (Note: backend port 3001, NOT the Vite frontend port 8081)
# 5. Copy Client ID and Client Secret into this file below
# ═══════════════════════════════════════════════════════════
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=finsight-oauth-secret-key
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback
